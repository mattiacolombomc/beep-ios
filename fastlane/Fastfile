require "tmpdir"
require "pilot"
require "fileutils"

PROJECT      = "Beep.xcodeproj"
PROJECT_YML  = File.expand_path("../project.yml", __dir__)
APP_BUNDLE   = "com.mattiacolombo.Beep"
WIDGET_BUNDLE = "com.mattiacolombo.Beep.BeepWidget"
APP_PROFILE    = "Beep AppStore"
WIDGET_PROFILE = "Beep Widget AppStore"
MAC_PROFILE    = "Beep Mac AppStore"
IOS_TARGET   = "Beep"
IOS_SCHEME   = "Beep"
MAC_SCHEME   = "BeepMac"
TEAM_ID      = "M9YL94W837"

default_platform(:ios)

def asc_api_key
  key_id    = ENV.fetch("ASC_KEY_ID")
  issuer_id = ENV.fetch("ASC_ISSUER_ID")

  if (content = ENV["ASC_KEY_CONTENT"]) && !content.strip.empty?
    app_store_connect_api_key(
      key_id:                key_id,
      issuer_id:             issuer_id,
      key_content:           content,
      is_key_content_base64: false,
      in_house:              false
    )
  elsif (path = ENV["ASC_KEY_PATH"]) && !path.strip.empty?
    app_store_connect_api_key(
      key_id:       key_id,
      issuer_id:    issuer_id,
      key_filepath: File.expand_path(path),
      in_house:     false
    )
  else
    UI.user_error!("Set ASC_KEY_CONTENT (via 1Password) or ASC_KEY_PATH in fastlane/.env")
  end
end

# The Xcode project is generated by XcodeGen from project.yml, so the build number
# is bumped in BOTH files: project.yml (source of truth) and the committed pbxproj.
# iOS and macOS share one bundle ID and one build number in project.yml, so the next
# number is one past the highest of both platforms: either lane can run first.
def bump_build_to_latest_plus_one(api_key:)
  latest = %w[ios osx].map do |platform|
    latest_testflight_build_number(
      app_identifier:       APP_BUNDLE,
      platform:             platform,
      api_key:              api_key,
      initial_build_number: 0
    ).to_i
  end.max
  next_build = latest + 1
  # project.yml is the source of truth: bump it there and regenerate, so every target
  # (app, widget, tests) gets the same build number and the committed pbxproj stays canonical.
  yml = File.read(PROJECT_YML)
  File.write(PROJECT_YML, yml.sub(/CURRENT_PROJECT_VERSION: "\d+"/, "CURRENT_PROJECT_VERSION: \"#{next_build}\""))
  sh "cd .. && xcodegen generate -q"
  next_build
end

# Cloud signing straight from the ASC API key: no Xcode account session, no local distribution cert.
def auth_xcargs
  key_id    = ENV.fetch("ASC_KEY_ID")
  issuer_id = ENV.fetch("ASC_ISSUER_ID")
  path = ENV["ASC_KEY_PATH"]
  if (content = ENV["ASC_KEY_CONTENT"]) && !content.strip.empty?
    # Owner-only temp dir + exclusive create: no world-readable window, no symlink follow. Removed at exit.
    dir = Dir.mktmpdir("beep-asc-")
    path = File.join(dir, "AuthKey_#{key_id}.p8")
    # 1Password may hand the PEM over with escaped newlines; xcodebuild needs a real multi-line file.
    pem = content.gsub('\\n', "\n").strip + "\n"
    File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) { |f| f.write(pem) }
    at_exit { FileUtils.rm_rf(dir) }
  end
  "-allowProvisioningUpdates -allowProvisioningDeviceRegistration " \
  "-authenticationKeyPath #{File.expand_path(path)} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"
end

def commit_and_push(message)
  paths = ["#{PROJECT}/project.pbxproj", PROJECT_YML]
  git_add(path: paths)
  begin
    git_commit(path: paths, message: message)
  rescue => e
    UI.important("Skip commit: #{e.message}")
  end
  push_to_git_remote(remote: "origin", local_branch: "HEAD", remote_branch: "main")
end

before_all do |lane|
  next unless [:beta_ios, :beta_mac].include?(lane)   # tester management lanes don't touch the tree
  ensure_git_status_clean(show_uncommitted_changes: true)
  sh "git pull --rebase --autostash origin main"
  sh "cd .. && xcodegen generate -q"
  ensure_git_status_clean(show_uncommitted_changes: true)
end

# Distribution certificate + App Store profiles through the API key (Spaceship), installed locally.
# Release configs in project.yml reference these profile names, so the archive signs manually.
def ensure_signing(api_key)
  out = Dir.mktmpdir("beep-signing-")
  get_certificates(api_key: api_key, generate_apple_certs: true, team_id: "M9YL94W837", output_path: out)
  get_provisioning_profile(api_key: api_key, app_identifier: APP_BUNDLE, provisioning_name: APP_PROFILE, force: true, team_id: "M9YL94W837", output_path: out)
  get_provisioning_profile(api_key: api_key, app_identifier: WIDGET_BUNDLE, provisioning_name: WIDGET_PROFILE, force: true, team_id: "M9YL94W837", output_path: out)
end

desc "Archive, upload to TestFlight and commit the build bump"
lane :beta_ios do
  api_key = asc_api_key
  ensure_signing(api_key)
  build = bump_build_to_latest_plus_one(api_key: api_key)
  build_app(
    project:               PROJECT,
    scheme:                IOS_SCHEME,
    configuration:         "Release",
    export_method:         "app-store",
    destination:           "generic/platform=iOS",
    output_name:           "Beep-iOS",
    clean:                 true,
    silent:                true,
    suppress_xcode_output: true,
    export_options: {
      signingStyle: "manual",
      provisioningProfiles: { APP_BUNDLE => APP_PROFILE, WIDGET_BUNDLE => WIDGET_PROFILE }
    }
  )
  upload_to_testflight(
    api_key:                           api_key,
    app_identifier:                    APP_BUNDLE,
    app_platform:                      "ios",
    skip_waiting_for_build_processing: true,
    skip_submission:                   true
  )
  commit_and_push("chore: bump iOS build to #{build} for TestFlight")
end

# Mac App Store: the app is signed "Apple Distribution" with a macOS App Store profile,
# and the upload is a .pkg signed with the "Mac Installer Distribution" certificate.
def ensure_mac_signing(api_key)
  out = Dir.mktmpdir("beep-mac-signing-")
  get_certificates(api_key: api_key, generate_apple_certs: true, team_id: TEAM_ID, output_path: out)
  # cert publishes the last certificate it handled, and sigh would reuse it: keep the Apple Distribution one.
  distribution_cert = lane_context[SharedValues::CERT_CERTIFICATE_ID]
  get_certificates(api_key: api_key, type: "mac_installer_distribution", platform: "macos", team_id: TEAM_ID, output_path: out)
  get_provisioning_profile(api_key: api_key, app_identifier: APP_BUNDLE, provisioning_name: MAC_PROFILE, platform: "macos",
                           cert_id: distribution_cert, force: true, team_id: TEAM_ID, output_path: out)
end

desc "One-time: add the macOS platform to the App Store Connect record (universal purchase with iOS)"
lane :add_mac_platform do |options|
  api_key = asc_api_key
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE) or UI.user_error!("App #{APP_BUNDLE} not found")
  existing = app.get_app_store_versions(filter: { platform: "MAC_OS" })
  if existing.any?
    UI.success("macOS already added (#{existing.map(&:version_string).join(", ")})")
    next
  end
  version = options[:version] || File.read(PROJECT_YML)[/MARKETING_VERSION: "([^"]+)"/, 1]
  body = { data: { type: "appStoreVersions",
                   attributes: { platform: "MAC_OS", versionString: version },
                   relationships: { app: { data: { type: "apps", id: app.id } } } } }
  Spaceship::ConnectAPI.tunes_request_client.post("v1/appStoreVersions", body)
  UI.success("macOS platform added with version #{version}")
end

desc "Archive the Mac app, upload it to TestFlight (macOS) and commit the build bump"
lane :beta_mac do
  api_key = asc_api_key
  ensure_mac_signing(api_key)
  build = bump_build_to_latest_plus_one(api_key: api_key)
  build_mac_app(
    project:               PROJECT,
    scheme:                MAC_SCHEME,
    configuration:         "Release",
    export_method:         "app-store",
    output_name:           "Beep-macOS",
    clean:                 true,
    silent:                true,
    suppress_xcode_output: true,
    export_options: {
      signingStyle: "manual",
      provisioningProfiles: { APP_BUNDLE => MAC_PROFILE }
    }
  )
  upload_to_testflight(
    api_key:                           api_key,
    app_identifier:                    APP_BUNDLE,
    app_platform:                      "osx",
    pkg:                               lane_context[SharedValues::PKG_OUTPUT_PATH],
    skip_waiting_for_build_processing: true,
    skip_submission:                   true
  )
  commit_and_push("chore: bump build to #{build} for Mac TestFlight")
end

desc "Set the marketing version in project.yml + pbxproj: fastlane bump_version version:0.2.0"
lane :bump_version do |options|
  version = options[:version]
  UI.user_error!("Pass version like: fastlane bump_version version:0.2.0") if version.nil? || version.empty?
  increment_version_number_in_xcodeproj(xcodeproj: PROJECT, target: IOS_TARGET, version_number: version)
  yml = File.read(PROJECT_YML)
  File.write(PROJECT_YML, yml.sub(/MARKETING_VERSION: "[^"]+"/, "MARKETING_VERSION: \"#{version}\""))
  paths = ["#{PROJECT}/project.pbxproj", PROJECT_YML]
  git_add(path: paths)
  git_commit(path: paths, message: "chore: bump marketing version to #{version}")
  UI.success("Version bumped to #{version}.")
end

desc "Invite an external TestFlight tester: fastlane add_tester email:x@y.z first:Name last:Surname group:Amici"
lane :add_tester do |options|
  api_key = asc_api_key
  email = options[:email] or UI.user_error!("Pass email:")
  group = options[:group] || "Amici"
  Pilot::TesterManager.new.add_tester(
    api_key:        api_key,
    app_identifier: APP_BUNDLE,
    email:          email,
    first_name:     options[:first] || "",
    last_name:      options[:last] || "",
    groups:         [group]
  )
  UI.success("#{email} added to TestFlight group '#{group}'")
end

BETA_DESCRIPTION = "Beep tiene sincronizzati i file dei tuoi corsi WeBeep (Politecnico di Milano): download automatici, novità, ricerca nei file, annunci e notifiche. Client non ufficiale, richiede un account Polimi."
FEEDBACK_EMAIL   = "mattia@mattiacolombo.engineering"

# TestFlight "Test Information" (beta description + feedback email) for the primary locale.
def ensure_beta_app_info(api_key)
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE) or UI.user_error!("App #{APP_BUNDLE} not found")
  attrs = { description: BETA_DESCRIPTION, feedbackEmail: FEEDBACK_EMAIL }
  locs = app.get_beta_app_localizations
  if locs.empty?
    Spaceship::ConnectAPI.post_beta_app_localizations(app_id: app.id, attributes: attrs.merge(locale: app.primary_locale || "it"))
    UI.message("Created beta app localization")
  else
    UI.message("Beta app localization already present (#{locs.size}), leaving it as is")
  end
end

desc "Submit the latest build to the external group (triggers Beta App Review on the first build)"
lane :distribute_external do |options|
  api_key = asc_api_key
  ensure_beta_app_info(api_key)
  group = options[:group] || "Amici"
  upload_to_testflight(
    api_key:            api_key,
    app_identifier:     APP_BUNDLE,
    app_platform:       options[:platform] || "ios",   # "ios" or "osx"
    skip_submission:    false,
    distribute_only:    true,
    distribute_external: true,
    notify_external_testers: true,
    build_number:       options[:build],   # e.g. build:4; nil = latest processed build
    groups:             [group],
    changelog:          options[:changelog] || "Prima beta di Beep: sync WeBeep, download automatici, ricerca file, notifiche.",
    beta_app_description: "Beep tiene sincronizzati i file dei tuoi corsi WeBeep (Politecnico di Milano): download automatici, novità, ricerca nei file, annunci e notifiche. Client non ufficiale, richiede un account Polimi.",
    beta_app_feedback_email: "mattia@mattiacolombo.engineering",
    localized_app_info: {
      "default" => {
        feedback_email: "mattia@mattiacolombo.engineering",
        description: "Beep tiene sincronizzati i file dei tuoi corsi WeBeep (Politecnico di Milano): download automatici, novità, ricerca nei file, annunci e notifiche. Client non ufficiale, richiede un account Polimi."
      }
    },
    beta_app_review_info: {
      contact_email:      "mattia@mattiacolombo.engineering",
      contact_first_name: "Mattia",
      contact_last_name:  "Colombo",
      contact_phone:      "+39 3920002350",
      demo_account_name:     "demo",
      demo_account_password: "BeepReview2026",
      demo_account_required: true,
      notes:              "Unofficial client for Politecnico di Milano's WeBeep (Moodle); a real sign-in needs a Polimi student account, so the app ships a demonstration mode. To use it: on the Welcome screen tap 'Sign in', then in the toolbar menu (…) choose 'Enter token manually' and paste the password above into the Token field, then tap 'Sign in'. The app then loads sample courses and files; downloads, Quick Look, search, filters, widget and settings all work on that sample data. Available from build 4 onward."
    }
  )
end

desc "External group with a public TestFlight link: fastlane public_group group:PoliNetwork"
lane :public_group do |options|
  api_key = asc_api_key
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE) or UI.user_error!("App not found")
  name = options[:group] || "PoliNetwork"
  groups = Spaceship::ConnectAPI.get_beta_groups(filter: { app: app.id }).all_pages.flat_map(&:to_models)
  group = groups.find { |g| g.name == name }
  if group
    UI.message("Group '#{name}' already exists")
  else
    group = app.create_beta_group(group_name: name, is_internal_group: false,
                                  public_link_enabled: true, public_link_limit_enabled: false)
    UI.success("Created external group '#{name}' with a public link")
  end
  unless group.public_link_enabled
    Spaceship::ConnectAPI.test_flight_request_client.patch("v1/betaGroups/#{group.id}",
      { data: { type: "betaGroups", id: group.id, attributes: { publicLinkEnabled: true, publicLinkLimitEnabled: false } } })
    group = Spaceship::ConnectAPI.get_beta_groups(filter: { app: app.id }).all_pages.flat_map(&:to_models).find { |g| g.id == group.id }
  end
  UI.success("Public link: #{group.public_link || "(appears once a build is approved for the group)"}")
end

desc "Testers per TestFlight group (public-link joins included): fastlane tester_stats [details:true]"
lane :tester_stats do |options|
  api_key = asc_api_key
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE) or UI.user_error!("App not found")
  groups = Spaceship::ConnectAPI.get_beta_groups(filter: { app: app.id }).all_pages.flat_map(&:to_models)
  groups.each do |g|
    testers = Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: g.id }).all_pages.flat_map(&:to_models)
    kind = g.is_internal_group ? "interno" : "esterno"
    by_state = testers.group_by { |t| t.invite_type || "?" }.map { |k, v| "#{k}=#{v.size}" }.join(" ")
    UI.message("#{g.name} (#{kind}): #{testers.size} tester  #{by_state}#{g.public_link ? "  link: #{g.public_link}" : ""}")
    next unless options[:details]
    testers.each do |t|
      who = [t.first_name, t.last_name].compact.join(" ").strip
      who = "anonimo" if who.empty?
      build = t.installed_cf_bundle_version ? "build #{t.installed_cf_bundle_version}" : "non installata"
      device = [t.installed_device || t.latest_installed_device, t.installed_os_version || t.latest_installed_os_version].compact.join(" ")
      UI.message("   - #{who} <#{t.email || "-"}>  invito=#{t.invite_type}  stato=#{t.beta_tester_state}  #{build}  #{device}")
    end
  end
end

desc "Internal TestFlight group with access to every build, with the team account as tester"
lane :internal_testers do |options|
  api_key = asc_api_key
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE) or UI.user_error!("App not found")
  email = options[:email] || "mattia@mattiacolombo.engineering"
  groups = Spaceship::ConnectAPI.get_beta_groups(filter: { app: app.id }).all_pages.flat_map(&:to_models)
  group = groups.find { |g| g.is_internal_group }
  unless group
    body = { data: { type: "betaGroups",
                     attributes: { name: "Team", isInternalGroup: true, hasAccessToAllBuilds: true },
                     relationships: { app: { data: { type: "apps", id: app.id } } } } }
    group = Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaGroups", body).to_models.first
    UI.message("Created internal group 'Team'")
  end
  UI.message("Internal group: #{group.name} (all builds: #{group.has_access_to_all_builds})")
  existing = Spaceship::ConnectAPI.get_beta_testers(filter: { email: email, betaGroups: group.id }).all_pages.flat_map(&:to_models)
  if existing.empty?
    tester_body = { data: { type: "betaTesters",
                            attributes: { email: email, firstName: options[:first] || "Mattia", lastName: options[:last] || "Colombo" },
                            relationships: { betaGroups: { data: [{ type: "betaGroups", id: group.id }] } } } }
    Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaTesters", tester_body)
    UI.success("#{email} added to internal group #{group.name}")
  else
    UI.success("#{email} already in #{group.name}")
  end
end

desc "List TestFlight builds with their Beta App Review state"
lane :review_status do
  api_key = asc_api_key
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE)
  builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, includes: "betaAppReviewSubmission,preReleaseVersion", sort: "-uploadedDate", limit: 20)
  builds.each do |b|
    state = b.beta_app_review_submission&.beta_review_state || "-"
    UI.message("#{b.pre_release_version&.platform} #{b.pre_release_version&.version} (#{b.version})  processing=#{b.processing_state}  expired=#{b.expired}  review=#{state}")
  end
end

desc "Withdraw a build from TestFlight (also cancels its beta review): fastlane expire_build build:3"
lane :expire_build do |options|
  api_key = asc_api_key
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE)
  number = options[:build] or UI.user_error!("Pass build:N")
  build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: number.to_s).first or UI.user_error!("Build #{number} not found")
  build.expire!
  UI.success("Build #{number} expired")
end
