# Copy this file to fastlane/.env and fill in the values.
# Generate the key in App Store Connect: Users and Access > Integrations > App Store Connect API.
# The .p8 file is downloadable ONLY ONCE.

# === Approach 1 (RECOMMENDED): 1Password CLI ===
# Store the API key in 1Password, then reference op:// paths here.
# Run lanes with:  op run --env-file=fastlane/.env -- fastlane beta_all
#
# Example item structure in 1Password (vault "Private", item "App Store Connect API Key"):
#   - field "key_id"      = ABCD123456
#   - field "issuer_id"   = 00000000-0000-0000-0000-000000000000
#   - field "private_key" = <contents of AuthKey_XXXX.p8>

ASC_KEY_ID="op://Private/App Store Connect API Key/key_id"
ASC_ISSUER_ID="op://Private/App Store Connect API Key/issuer_id"
ASC_KEY_CONTENT="op://Private/App Store Connect API Key/private_key"

# === Approach 2 (fallback): plain file on disk ===
# Comment out the op:// lines above and uncomment these.
# Less secure: the .p8 file lives on disk in cleartext.
#
# ASC_KEY_ID=ABCD123456
# ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ASC_KEY_PATH=~/.appstoreconnect/AuthKey_ABCD123456.p8
