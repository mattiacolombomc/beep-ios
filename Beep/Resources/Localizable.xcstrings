    "Files": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        }
      }
    },
    "Files are saved in Files → On My iPhone → Beep, one folder per course, so any app can open and edit them.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file sono salvati in File → Sul mio iPhone → Beep, una cartella per corso, così qualsiasi app può aprirli e modificarli."
          }
        }
      }
    },
    "Files in every course": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File in tutti i corsi"
          }
        }
      }
    },
    "Files live in the Files app, ready for GoodNotes, Notability or anything else.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vivono nell'app File, pronti per GoodNotes, Notability o qualsiasi altra app."
          }
        }
      }
    },
    "Files of “%@” live in Files → Beep → this folder. Existing downloads are moved.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file di “%@” stanno in File → Beep → questa cartella. I download esistenti vengono spostati."
          }
        }
      }
    },
    "Files you download or that sync automatically show up here, course by course.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file che scarichi o che si sincronizzano da soli compaiono qui, corso per corso."
          }
        }
      }
    },
    "Files you open or download appear here and in the Files app.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file che apri o scarichi compaiono qui e nell'app File."
          }
        }
      }
    },
