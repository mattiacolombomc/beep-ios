    "Beep": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Beep"
          }
        }
      }
    },
    "Beep author": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autore di Beep"
          }
        }
      }
    },
    "Beep checks WeBeep in the background and tells you when professors upload something. No spam: one notification per check.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Beep controlla WeBeep in background e ti avvisa quando i docenti caricano qualcosa. Niente spam: una notifica per controllo."
          }
        }
      }
    },
    "Beep is inspired by and partly derived from myPoliFile, the first unofficial iOS client for WeBeep.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Beep è ispirata a myPoliFile, il primo client iOS non ufficiale per WeBeep, e ne riprende in parte il codice."
          }
        }
      }
    },
    "Beep is not affiliated with, endorsed by, or sponsored by Politecnico di Milano. WeBeep is a trademark of its owner.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Beep non è affiliata, approvata o sponsorizzata dal Politecnico di Milano. WeBeep è un marchio del rispettivo proprietario."
          }
        }
      }
    },
    "Beep renews the WeBeep access key by itself about every 4 weeks, before it can expire. If WeBeep rejects it anyway you get a notification and a quick sign-in.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Beep rinnova da solo la chiave di accesso WeBeep circa ogni 4 settimane, prima che possa scadere. Se WeBeep la rifiuta comunque ricevi una notifica e un accesso rapido."
          }
        }
      }
    },
    "Bulk actions": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azioni in blocco"
          }
        }
